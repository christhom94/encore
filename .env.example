# setlist.fm API key (free): setlist.fm account settings > API
SETLISTFM_API_KEY=

# Sent in the User-Agent when fetching setlist.fm stats pages, so they can contact you
CONTACT_EMAIL=

# Where play counts come from: stats (setlist.fm stats pages) or aggregate (sum setlists via the API)
COUNT_SOURCE=stats

# Local SQLite file in development; hosted database URL in production
DATABASE_URL=file:./encore.db

# Minimum performances for a song to appear in a deck
MIN_PLAYS=10
